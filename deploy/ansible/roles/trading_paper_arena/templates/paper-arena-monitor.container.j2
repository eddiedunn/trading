# Managed by ~/code/trading/deploy/ansible (role trading_paper_arena). Do not edit here.
[Unit]
Description=Trading Paper Arena Monitor
After=network-online.target podman.socket trading-postgres.service
Requires=trading-postgres.service

[Container]
Image={{ paper_arena_image }}
ContainerName=paper-arena-monitor
Exec=python -m paper.monitor
# Host network: paper instances publish on 127.0.0.1:<port>, Postgres on 127.0.0.1.
Network=host
Volume={{ paper_arena_dir }}:{{ paper_arena_dir }}:Z
Volume={{ podman_socket }}:/run/podman/podman.sock
Environment=TRADING_PAPER_DIR={{ paper_arena_dir }}
Environment=TRADING_PAPER_FT_DATA_DIR={{ paper_arena_ftdata_dir }}
Environment=POSTGRES_HOST=127.0.0.1
Environment=POSTGRES_PORT={{ trading_postgres_port }}
Environment=POSTGRES_DB={{ trading_postgres_db }}
Environment=POSTGRES_USER={{ trading_postgres_user }}
Environment=POSTGRES_PASSWORD={{ trading_postgres_password }}
Environment=FREQTRADE_API_USER={{ freqtrade_api_user }}
Environment=FREQTRADE_API_PASSWORD={{ freqtrade_api_password }}
Environment=TRADING_ENV={{ trading_env }}
{% if telegram_chat_id %}
Environment=TELEGRAM_CHAT_ID={{ telegram_chat_id }}
{% for slot in range(telegram_paper_slots) %}
{% set token = lookup('pipe', 'gopass show -o ' + _trading_gopass_prefix + '/telegram/paper-bot-token-' + (slot | string) + ' 2>/dev/null || true') %}
{% if token %}
Environment=TELEGRAM_BOT_TOKEN_{{ slot }}={{ token }}
{% endif %}
{% endfor %}
{% endif %}
Environment=PYTHONUNBUFFERED=1

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
