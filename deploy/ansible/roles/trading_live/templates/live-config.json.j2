{
  "exchange": {
    "name": "hyperliquid",
{% if not (trading_live_dry_run | bool) %}
    "walletAddress": {{ hyperliquid_wallet_address | to_json }},
    "privateKey": {{ hyperliquid_private_key | to_json }},
{% endif %}
    "ccxt_config": {
      "options": {
        "defaultType": "swap"
      }{% if trading_env == 'testnet' %},
      "urls": {
        "api": {
          "public": {{ _hyperliquid_api_url | to_json }},
          "private": {{ _hyperliquid_api_url | to_json }}
        }
      }
{% endif %}
    },
    "pair_whitelist": {{ trading_live_pairs | to_json }},
    "pair_blacklist": []
  },
  "pairlists": [{"method": "StaticPairList"}],
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "stake_currency": "USDC",
  "stake_amount": {{ trading_live_stake_amount }},
  "max_open_trades": {{ trading_live_max_open_trades }},
  "timeframe": "{{ trading_live_timeframe }}",
  "dry_run": {{ trading_live_dry_run | bool | to_json }},
  "dry_run_wallet": {{ trading_live_dry_run_wallet }},
  "db_url": "sqlite:////freqtrade/user_data/{{ 'tradesv3.dryrun.sqlite' if trading_live_dry_run | bool else 'tradesv3.sqlite' }}",
  "stoploss": -0.05,
  "trailing_stop": true,
  "trailing_stop_positive": 0.02,
  "entry_pricing": {"price_side": "same"},
  "exit_pricing": {"price_side": "same"},
  "api_server": {
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": true,
    "jwt_secret_key": "{{ freqtrade_api_password | hash('sha256') }}",
    "CORS_origins": [],
    "username": {{ freqtrade_api_user | to_json }},
    "password": {{ freqtrade_api_password | to_json }}
  },
  "bot_name": "trading-live",
  "initial_state": "running",
  "force_entry_enable": false,
  "internals": {
    "process_throttle_secs": 5
  }
}
