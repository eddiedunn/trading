# Managed by ~/code/trading/deploy/ansible (role trading_postgres). Do not edit here.
[Unit]
Description=Trading Stack Postgres
After=network-online.target

[Container]
Image={{ trading_postgres_image }}
ContainerName=trading-postgres
PublishPort=127.0.0.1:{{ trading_postgres_port }}:5432
Volume={{ trading_postgres_data_dir }}:/var/lib/postgresql/data:Z
Environment=POSTGRES_DB={{ trading_postgres_db }}
Environment=POSTGRES_USER={{ trading_postgres_user }}
Environment=POSTGRES_PASSWORD={{ trading_postgres_password }}

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
